{
  "multipart": [
    { "apply": { "model": "tadackosdrinks:block/trellis_spruce" } },
    { "when": { "down": "trellis" }, "apply": { "model": "tadackosdrinks:block/trellis_side_spruce" } },
    { "when": { "down": "other" }, "apply": { "model": "tadackosdrinks:block/trellis_roped" } },
    { "when": { "up": true }, "apply": { "model": "tadackosdrinks:block/trellis_side_spruce", "x": 180 } },
    { "when": { "south": "trellis" }, "apply": { "model": "tadackosdrinks:block/trellis_side_spruce", "x": 90, "y": 0 } },
    { "when": { "south": "other" }, "apply": { "model": "tadackosdrinks:block/trellis_wired", "y": 180 } },
    { "when": { "west": "trellis" }, "apply": { "model": "tadackosdrinks:block/trellis_side_spruce", "x": 90, "y": 90 } },
    { "when": { "west": "other" }, "apply": { "model": "tadackosdrinks:block/trellis_wired", "y": 270 } },
    { "when": { "north": "trellis" }, "apply": { "model": "tadackosdrinks:block/trellis_side_spruce", "x": 90, "y": 180 } },
    { "when": { "north": "other" }, "apply": { "model": "tadackosdrinks:block/trellis_wired" } },
    { "when": { "east": "trellis" }, "apply": { "model": "tadackosdrinks:block/trellis_side_spruce", "x": 90, "y": 270 } },
    { "when": { "east": "other" }, "apply": { "model": "tadackosdrinks:block/trellis_wired", "y": 90 } }
  ]
}