{
  "multipart": [
    { "when": { "facing": "north" }, "apply": { "model": "tadackosdrinks:block/fermenting_barrel_birch" } },
    { "when": { "facing": "east"  }, "apply": { "model": "tadackosdrinks:block/fermenting_barrel_birch", "y": 90 } },
    { "when": { "facing": "south" }, "apply": { "model": "tadackosdrinks:block/fermenting_barrel_birch", "y": 180 } },
    { "when": { "facing": "west"  }, "apply": { "model": "tadackosdrinks:block/fermenting_barrel_birch", "y": 270 } },

    { "when": { "closed": true, "facing": "north" }, "apply": { "model": "tadackosdrinks:block/fermenting_barrel_lid_birch" } },
    { "when": { "closed": true, "facing": "east"  }, "apply": { "model": "tadackosdrinks:block/fermenting_barrel_lid_birch", "y": 90 } },
    { "when": { "closed": true, "facing": "south" }, "apply": { "model": "tadackosdrinks:block/fermenting_barrel_lid_birch", "y": 180 } },
    { "when": { "closed": true, "facing": "west"  }, "apply": { "model": "tadackosdrinks:block/fermenting_barrel_lid_birch", "y": 270 } },

    { "when": { "closed": true, "clock": true, "facing": "north" }, "apply": { "model": "tadackosdrinks:block/fermenting_barrel_clock" } },
    { "when": { "closed": true, "clock": true, "facing": "east"  }, "apply": { "model": "tadackosdrinks:block/fermenting_barrel_clock", "y": 90 } },
    { "when": { "closed": true, "clock": true, "facing": "south" }, "apply": { "model": "tadackosdrinks:block/fermenting_barrel_clock", "y": 180 } },
    { "when": { "closed": true, "clock": true, "facing": "west"  }, "apply": { "model": "tadackosdrinks:block/fermenting_barrel_clock", "y": 270 } }
  ]
}
